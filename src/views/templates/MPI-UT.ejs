<%
const d = data || {};

const imageField = "equipmentImage";

const mpiRows =
  d.tables?.find(
    t => t.name === "mpi-ut-report"
  )?.rows || [];

const utRows =
  d.tables?.find(
    t => t.name === "ut-reading"
  )?.rows || [];

  const viewMode =
  typeof isView !== 'undefined' ? isView : false;

%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<title>
Magnetic Particle Inspection /
Ultrasonic Test Report
</title>

<style>

@page{
    size:A4;
    margin:0;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    font-size:12px;
    color:#000;
    margin:0;
    background:#f2f2f2;
}

#certificate{
    width:210mm;
    margin:auto;
    padding:5mm 15mm 10mm;
    background:#fff;
    box-sizing:border-box;
}

/* ===========================
   LETTERHEAD / HEADER
=========================== */

.cert-header{
    width:100%;
    text-align:center;
    margin:0 0 12px;
    padding:0;
    overflow:hidden;
}

.cert-header img#letterhead{
    width:105;
    max-width:100%;
    height:auto;
    max-height:80px;
    object-fit:contain;
    display:block;
    margin:0 auto;
}


.title{
    text-align:center;
    font-size:20px;
    font-weight:bold;
    line-height:1.6;
    margin-top:10px;
}

.section-heading{
    border:1px solid #000;
    text-align:center;
    font-weight:bold;
    font-size:18px;
    margin-top:20px;
    padding:4px;
}

.info{
    width:100%;
    margin:15px auto;
}

.info-row{
    display:flex;
    justify-content:space-between;
    margin:5px 0;
}

.info-left,
.info-right{
    width:48%;
}

.label{
    font-weight:bold;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
}

th,td{
    border:1px solid #000;
    padding:4px;
    text-align:center;
    vertical-align:middle;
}

input,
textarea,
select{
    width:100%;
    border:none;
    outline:none;
    background:transparent;
    font-size:11px;
    font-family:inherit;
}

textarea{
    resize:none;
}

.report-title{
    text-align:center;
    font-size:20px;
    font-weight:bold;
    margin:25px 0;
}

.pdf-hide{
    display:<%= isPdf ? "none" : "block" %>;
}

.delete-btn{
    border:none;
    background:none;
    color:red;
    font-size:18px;
    cursor:pointer;
}

/* ===========================
   FLOATING DOWNLOAD BUTTON
=========================== */

.floating-download{
    position:fixed;
    top:18px;
    right:24px;
    z-index:9999;
}

.download-btn{
    background:#0f172a;
    color:#fff;
    border:none;
    border-radius:999px;
    padding:12px 18px;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    box-shadow:0 4px 12px rgba(0,0,0,.18);

    display:flex;
    align-items:center;
    gap:8px;

    transition:.2s;
}

.download-btn:hover{
    background:#1e293b;
    transform:translateY(-1px);
}

.remark{
    margin-top:5px;
    margin-bottom:8px;
    font-size:14px;
    line-height:1.5;
}

.equipment-image-section{
    margin:8px auto 20px;
    text-align:center;
    page-break-inside:avoid;
}

.equipment-image-title{
    font-size:14px;
    font-weight:bold;
    margin-bottom:6px;
}

.equipment-image-box{
    width:150px;
    height:130px;
    border:1px solid #000;
    display:flex;
    justify-content:center;
    align-items:center;
    overflow:hidden;
    margin:0 auto;
}

.equipment-image{
    width:100%;
    height:100%;
    object-fit:contain;
    display:block;
}

.image-upload-container{
    margin-top:8px;
}

.equipment-image-placeholder{
    font-size:14px;
    color:#777;
}

.footer{
    margin-top:20px;
}

.remark,
.equipment-image-section,
.inspected,
.footer{
    page-break-inside: avoid;
    break-inside: avoid;
}

@media print{
    .pdf-hide{
        display:none !important;
    }

    .floating-download{
        display:none !important;
    }

}

</style>
</head>

<body data-cert-type="MPI-UT" data-is-view="<%= viewMode ? 'true' : 'false' %>">

<div id="certificate">

  <!-- ===================================== -->
  <!-- FLOATING DOWNLOAD BUTTON -->
  <!-- ===================================== -->


    <% if (!isPdf) { %>

    <div class="floating-download pdf-hide">

        <button
            type="button"
            class="download-btn"
            onclick="downloadPDF(event)"
        >
            ⬇ Download PDF
        </button>

    </div>

    <% } %>

<div class="cert-header">
<img
id="letterhead"
src="<%= branding?.letterhead || '' %>"
>
</div>

<div class="title">
MAGNETIC PARTICLE INSPECTION / ULTRASONIC TEST
<br>
(THICKNESS MEASUREMENT) REPORT
</div>

<div class="section-heading">
MAGNETIC PARTICLE ON THREAD
</div>

<div class="info">

<div class="info-row">

<div class="info-left">
<span class="label">STANDARD:</span>

<input
name="standard"
value="<%= d.standard || 'API SPEC 7, API 5A5' %>"
>
</div>

</div>

<div class="info-row">

<div class="info-left">
<span class="label">
Test Pressure:
</span>

<input
name="testPressure"
value="<%= d.testPressure || '' %>"
>
</div>

</div>

<div class="info-row">

<div class="info-left">

<span class="label">
Work Pressure:
</span>

<input
name="workPressure"
value="<%= d.workPressure || '' %>"
>

</div>

<div class="info-right">

<span class="label">
DATE:
</span>

<input
type="date"
name="inspectionDate"
data-stamp-date
value="<%= d.inspectionDate || '' %>"
>

</div>

</div>

<div class="info-row">

<div class="info-left">

<span class="label">
CLIENT:
</span>

<input
name="client"
value="<%= d.client || '' %>"
>

</div>

<div class="info-right">

<span class="label">
REPORT NO:
</span>

<input
name="reportNo"
value="<%= d.reportNo || '' %>"
>

</div>

</div>

</div>
<!-- ===================================== -->
<!-- FABRICATION TABLE -->
<!-- ===================================== -->

<table>

<tr>

    <th>
        FABRICATED BY
    </th>

    <th>
        COUNTRY OF ORIGIN
    </th>

    <th>
        TRACEABILITY S/NO
    </th>

    <th>
        DATE FABRICATED
    </th>

</tr>

<tr>

    <td>

        <input
            name="fabricatedBy"
            value="<%= d.fabricatedBy || '' %>"
        >

    </td>

    <td>

        <input
            name="countryOfOrigin"
            value="<%= d.countryOfOrigin || '' %>"
        >

    </td>

    <td>

        <input
            name="traceabilityNo"
            value="<%= d.traceabilityNo || '' %>"
        >

    </td>

    <td>

        <input
            type="date"
            name="dateFabricated"
            value="<%= d.dateFabricated || '' %>"
        >

    </td>

</tr>

</table>

<!-- ===================================== -->
<!-- MPI REPORT TABLE -->
<!-- ===================================== -->

<div class="report-title">

MAGNETIC PARTICLE INSPECTION
ON THREAD REPORT

</div>

<table>

<thead>

<tr>

    <th rowspan="2" style="width:8%;">
        S/NO
    </th>

    <th colspan="3">
        PIPE / CONNECTION REPORT
    </th>

    <th colspan="2">
        CONNECTION
    </th>

    <% if(!isPdf){ %>
    <th
      rowspan="2"
      class="pdf-hide"
      style="width:50px;"
    >
      DEL
    </th>
    <% } %>

</tr>

<tr>

    <th>
        DESCRIPTION
    </th>

    <th>
        I.D
    </th>

    <th>
        LENGTH
    </th>

    <th>
        OK
    </th>

    <th>
        OK
    </th>

</tr>

</thead>

<tbody
  data-table-name="mpi-ut-report"
  data-add-row="mpi-ut-report"
>

<% if (mpiRows.length) { %>

  <% mpiRows.forEach((row,index)=>{ %>

  <tr>

    <td class="sn">
      <%= index + 1 %>
    </td>

    <td>
      <input value="<%= row[0] || '' %>">
    </td>

    <td>
      <input value="<%= row[1] || '' %>">
    </td>

    <td>
      <input value="<%= row[2] || '' %>">
    </td>

    <td>
      <input value="<%= row[3] || '' %>">
    </td>

    <td>
      <input value="<%= row[4] || '' %>">
    </td>

    <% if(!isPdf){ %>

    <td class="pdf-hide">

      <button
        type="button"
        class="delete-btn"
        onclick="deleteRow(this)"
      >
        ×
      </button>

    </td>

    <% } %>

  </tr>

  <% }) %>

<% } else { %>

<tr>

  <td class="sn">1</td>

  <td><input></td>
  <td><input></td>
  <td><input></td>
  <td><input></td>
  <td><input></td>

  <% if(!isPdf){ %>

  <td class="pdf-hide">

    <button
      type="button"
      class="delete-btn"
      onclick="deleteRow(this)"
    >
      ×
    </button>

  </td>

  <% } %>

</tr>

<% } %>

</tbody>
</table>

<div
  class="pdf-hide"
  style="margin-top:8px;margin-bottom:20px;"
>

<button
  type="button"
  onclick="addRow('mpi-ut-report')"
>
  ➕ Add MPI/UT Row
</button>

</div>

<!-- ===================================== -->
<!-- UT READING TABLE -->
<!-- ===================================== -->

<table class="ut-table">

<thead>

<tr>

    <th colspan="<%= !isPdf ? 5 : 4 %>"
        style="
        text-align:left;
        padding-left:10px;
        "
    >
        UT READING IN MM
    </th>

</tr>

<tr>

    <th>12/E</th>

    <th>6/W</th>

    <th>9/N</th>

    <th>3/S</th>

    <% if(!isPdf){ %>
    <th
      class="pdf-hide"
      style="width:50px;"
    >
      DEL
    </th>
    <% } %>

</tr>

</thead>

<tbody
  data-table-name="ut-reading"
  data-add-row="ut-reading"
>

<% if (utRows.length) { %>

  <% utRows.forEach((row)=>{ %>

  <tr>

    <td>
      <input value="<%= row[0] || '' %>">
    </td>

    <td>
      <input value="<%= row[1] || '' %>">
    </td>

    <td>
      <input value="<%= row[2] || '' %>">
    </td>

    <td>
      <input value="<%= row[3] || '' %>">
    </td>

    <% if(!isPdf){ %>

    <td class="pdf-hide">

      <button
        type="button"
        class="delete-btn"
        onclick="deleteRow(this)"
      >
        ×
      </button>

    </td>

    <% } %>

  </tr>

  <% }) %>

<% } else { %>

<tr>

  <td><input></td>
  <td><input></td>
  <td><input></td>
  <td><input></td>

  <% if(!isPdf){ %>

  <td class="pdf-hide">

    <button
      type="button"
      class="delete-btn"
      onclick="deleteRow(this)"
    >
      ×
    </button>

  </td>

  <% } %>

</tr>

<% } %>

</tbody>
</table>

<div
  class="pdf-hide"
  style="margin-top:8px;margin-bottom:25px;"
>

<button
  type="button"
  onclick="addRow('ut-reading')"
>
  ➕ Add UT Reading
</button>

</div>
<!-- ===================================== -->
<!-- REMARK -->
<!-- ===================================== -->

<div class="remark">

<b>REMARK:</b>
<br/>
<textarea
name="remark"
rows="3"
style="
width:100%;
font-size:14px;
"
><%= d.remark ||
'This equipment has undergone thorough examination and check in accordance to ACTS, ASTM SE, ACT 23, ASTM E 1316, API SPEC 7 and API 5A5 Standard and found to be OK for use.' %></textarea>

</div>


<!-- ===================================== -->
<!-- EQUIPMENT IMAGE -->
<!-- ===================================== -->

<div class="equipment-image-section">

    <div class="equipment-image-title">
        EQUIPMENT IMAGE
    </div>

    <input
        id="<%= imageField %>Input"
        type="file"
        accept="image/*"
        data-field="<%= imageField %>"
        onchange="previewImage(this,'<%= imageField %>')"
        style="display:none;"
    >

    <div class="equipment-image-box">

        <img
            id="<%= imageField %>"
            class="equipment-image"
            src="<%= d.images?.[imageField] || '' %>"
            alt="Equipment Image"
        >

    </div>

    <% if (!isPdf) { %>

    <div class="image-upload-container pdf-hide">

        <button
            type="button"
            onclick="document.getElementById('<%= imageField %>Input').click()"
        >
            🖼 Select Image
        </button>

    </div>

    <% } %>

</div>


</button>

</div>

<!-- ===================================== -->
<!-- FOOTER -->
<!-- ===================================== -->

<div class="footer">

<div
style="
margin-top:40px;
display:flex;
justify-content:space-between;
align-items:flex-end;
page-break-inside:avoid;
"
>

<!-- LEFT -->

<div style="width:28%;">

<div
style="
font-size:13px;
font-weight:bold;
margin-bottom:5px;
"
>

TESTED AND INSPECTED BY


</div>

<img
id="inspectorSignature"
src="<%= branding?.signature || '' %>"
style="
width:140px;
display:block;
"
>

<div
style="
font-weight:bold;
font-size:13px;
"
>

ADAMS IWEZOR

</div>

<div
style="
font-size:12px;
"
>

ASNT LEVEL II UT, PT & MT

</div>

</div>

<!-- CENTER -->

<div
style="
width:44%;
text-align:center;
"
>

<div
style="
position:relative;
display:inline-block;
width:100%;
max-width:320px;
"
>

<img
id="stamp"
src="<%= branding?.stamp || '' %>"
style="
width:100%;
max-height:90px;
"
>

<div
style="
position:absolute;
bottom:12px;
left:20px;
font-size:12px;
font-weight:bold;
color:skyblue;
"
>

DATE :

<span id="stampDate">

<%=
d.inspectionDate
? new Date(d.inspectionDate)
.toLocaleDateString(
'en-GB',
{
day:'2-digit',
month:'2-digit',
year:'2-digit'
}
)
: ''
%>

</span>

</div>

</div>

</div>

<!-- RIGHT -->

<div
style="
width:28%;
display:flex;
justify-content:flex-end;
gap:10px;
"
>
    


<img
id="asnt"
src="<%= branding?.asnt || '' %>"
style="height:40px;"
>

<img
id="leea"
src="<%= branding?.leea || '' %>"
style="height:40px;"
>

<img
id="awrf"
src="<%= branding?.awrf || '' %>"
style="height:40px;"
>

</div>

</div>

</div>


</div> <!-- END CERTIFICATE -->

<script src="/js/certificate.js"></script>


</body>
</html>