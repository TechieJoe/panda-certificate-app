<input
name="certificateNo"
value="<%= d.certificateNo || '' %>"
>
</td>

</tr>

<tr>

<td>
Equipment Owner:
<br>
<input
name="equipmentOwner"
value="<%= d.equipmentOwner || '' %>"
>
</td>

<td>
Manufacturer:
