<input
type="date"
name="productionDate"
value="<%= d.productionDate || '' %>"
>
</td>

</tr>

<tr>

<td>
Specification:
<br>
<input
name="specification"
value="<%= d.specification || '' %>"
>
</td>

<td>
Edition:
<br>
<input
name="edition"
value="<%= d.edition || '2006' %>"
>
</td>

</tr>

<tr>

<td>
MPI Method:
<br>
<input
name="mpiMethod"
value="<%= d.mpiMethod || '' %>"
>
</td>

<td>
Method:
<br>
<input
name="method"
value="<%= d.method || 'Continuous' %>"
>
</td>

</tr>

<tr>

<td>
Equipment Used:
<br>
<input
name="equipmentUsed"
