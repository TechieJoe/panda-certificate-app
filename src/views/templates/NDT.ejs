<%
const d = data || {};

const imageField = "ndtImage";

const slingRows =
  d.tables?.find(
    table => table.name === "sling"
  )?.rows || [];

const shackleRows =
  d.tables?.find(
    table => table.name === "shackle"
  )?.rows || [];

  const viewMode =
  typeof isView !== 'undefined' ? isView : false;

%>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">

<title>
Certificate of Thorough Visual and NDT
</title>

<style>

@page{
  size:A4;
  margin:0;
}

body{
  font-family:Arial, Helvetica, sans-serif;
  font-size:11px;
  background:#f2f2f2;
  margin:0;
}

#certificate{
  width:210mm;
  margin:auto;
  padding:5mm 20mm 20mm 20mm;
  box-sizing:border-box;
  background:#fff;
}

.cert-header{
  margin:-5mm -12mm 5mm -12mm;
}

.cert-header img{
  width:100%;
  display:block;
}

h3{
  text-align:center;
  margin:0 0 6px;
  font-size:26px;
}

h4{
  margin:10px 0 6px;
}

.subtitle{
  text-align:center;
  font-size:10px;
  margin-bottom:10px;
  line-height:1.4;
}

table{
  width:100%;
  border-collapse:collapse;
  margin-bottom:8px;
}

th,
td{
  border:1px solid #000;
  padding:4px;
  vertical-align:top;
  word-wrap:break-word;
}

table,
tr,
td,
th{
  page-break-inside:avoid;
}

input,
textarea,
select{
  width:100%;
  border:none;
  outline:none;
  background:transparent;
  font-family:inherit;
  font-size:11px;
  box-sizing:border-box;
}

textarea{
  resize:none;
}

.image-box{
  width:100%;
  height:170px;
  border:1px solid #000;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

.image-box img{
  max-width:100%;
  max-height:100%;
  object-fit:contain;
}

.pdf-hide{
  display:<%= isPdf ? "none" : "block" %>;
}

.action-cell{
  width:45px;
  text-align:center;
}

.delete-btn{
  border:none;
  background:none;
  color:#c00;
  cursor:pointer;
  font-size:18px;
}

/* =====================================
   FLOATING DOWNLOAD BUTTON
===================================== */

.floating-toolbar{
    position:fixed;
    top:18px;
    right:24px;
    z-index:9999;
}

.toolbar-btn{

    min-width:52px;
    height:46px;

    padding:0 16px;

    border:none;
    border-radius:999px;

    background:#0f172a;
    color:#fff;

    font-family:Arial, Helvetica, sans-serif;
    font-size:13px;
    font-weight:600;

    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;

    cursor:pointer;

    box-shadow:
        0 5px 15px rgba(0,0,0,.18);

    transition:
        background .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
}

.toolbar-btn:hover{

    background:#1e293b;

    transform:translateY(-2px);

    box-shadow:
        0 8px 20px rgba(0,0,0,.23);
}

.toolbar-btn:active{

    transform:translateY(0);

}

.toolbar-btn:disabled{

    background:#334155 !important;

    cursor:not-allowed !important;

    opacity:.9 !important;

    transform:none !important;

    animation:downloadPulse 1.2s ease-in-out infinite;
}

@keyframes downloadPulse{

    0%{
        box-shadow:0 5px 15px rgba(0,0,0,.18);
    }

    50%{
        box-shadow:0 5px 24px rgba(15,23,42,.45);
    }

    100%{
        box-shadow:0 5px 15px rgba(0,0,0,.18);
    }

}

.certificate-footer{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  margin-top:20px;

  page-break-inside:avoid !important;
  break-inside:avoid !important;
}

.footer-left{
  width:28%;
}

.footer-center{
  width:44%;
  text-align:center;
}

.footer-right{
  width:28%;
  display:flex;
  justify-content:flex-end;
  gap:12px;
}

.signature-img{
  width:140px;
}

.cert-logo{
  height:40px;
}

.stamp-wrapper{
  position:relative;
  display:inline-block;
  width:100%;
}

.company-block{
  width:100%;
}

.stamp-overlay{
  position:absolute;
  bottom:13px;
  left:20px;
}

.stamp-date{
  font-size:12px;
  font-weight:bold;
  color:skyblue;
}

@media print{

.pdf-hide{
display:none !important;
}



}
</style>


</head>

<body data-cert-type="VISUAL-NDT" data-is-view="<%= viewMode ? 'true' : 'false' %>">

<div id="certificate">
<div class="cert-header">

<img
id="letterhead"
src="<%= branding?.letterhead || '' %>"
>

</div>

<h3>
CERTIFICATE OF THOROUGH VISUAL AND NDT
</h3>

<div class="subtitle">

STATUTORY INSTRUMENT 1998 NO. 2307 –
The Lifting Operations and Lifting Equipment Regulations 1998
<br>

STATUTORY INSTRUMENT 2008 NO. 1597 –
The Supply of Machinery (Safety) Regulations 1992
<br>

STATUTORY INSTRUMENT 1998 NO. 2306 –
The Provision and Use of Work Equipment Regulations 1998

</div>

<!-- TOP SECTION -->

<table>

<tr>

<td style="width:74%;">

<table>

<tr>

<td>
Equipment Type:
<br>
<input
name="equipmentType"
value="<%= d.equipmentType || '' %>"
>
</td>

<td>
Certificate No:
