</td>


<td style="width:26%;">

<input
id="<%= imageField %>Input"
type="file"
accept="image/*"
data-field="<%= imageField %>"
onchange="previewImage(this,'<%= imageField %>')"
style="display:none;"
>

<div class="image-box">

<img
id="<%= imageField %>"
