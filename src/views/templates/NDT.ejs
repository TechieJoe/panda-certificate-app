</table>

<h4>
SLING
</h4>

<table>

<thead>

<tr>

<th>S/N</th>
<th>Description</th>
<th>SWL</th>
<th>Test Date</th>
<th>Next Due Date</th>
<th>Remark</th>

<% if(!isPdf){ %>
<th class="pdf-hide">
DEL
</th>
<% } %>

</tr>

</thead>

<tbody
data-table-name="sling"
data-add-row="sling"
>

<% if(slingRows.length){ %>

<% slingRows.forEach((row,index)=>{ %>

<tr>

<td class="sn">
<%= index + 1 %>
</td>

<td><textarea><%= row[0] || '' %></textarea></td>
<td><textarea><%= row[1] || '' %></textarea></td>
<td><textarea><%= row[2] || '' %></textarea></td>
<td><textarea><%= row[3] || '' %></textarea></td>
<td><textarea><%= row[4] || '' %></textarea></td>

<% if(!isPdf){ %>

<td class="action-cell pdf-hide">

<button
type="button"
class="delete-btn"
onclick="deleteRow(this)"
>

×

</button>

</td>

<% } %>

</tr>

<% }) %>

<% } else { %>

<tr>

<td class="sn">1</td>

<td><textarea></textarea></td>
<td><textarea></textarea></td>
<td><textarea></textarea></td>
<td><textarea></textarea></td>
<td><textarea></textarea></td>

<% if(!isPdf){ %>

<td class="action-cell pdf-hide">

<button
type="button"
class="delete-btn"
onclick="deleteRow(this)"
>

×

</button>

</td>

<% } %>

</tr>

<% } %>

</tbody>

</table>

<div class="pdf-hide">
<button type="button" onclick="addRow()">
➕ Add Sling
</button>
</div>

