</td>


<% if(!isPdf){ %>

<td class="action-cell pdf-hide">

<button
type="button"
class="delete-btn"
onclick="deleteRow(this)"
>
×
</button>

</td>

<% } %>

</tr>


<% } %>


</tbody>

</table>


<div class="pdf-hide">

<button
type="button"
onclick="addRow('sling')"
