<%
const d = data || {};

const imageField = "ndtImage";

const slingRows =
  d.tables?.find(
    table => table.name === "sling"
  )?.rows || [];

const shackleRows =
  d.tables?.find(
    table => table.name === "shackle"
  )?.rows || [];

const viewMode =
  typeof isView !== 'undefined' ? isView : false;

%>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">

<title>
Certificate of Thorough Visual and NDT
</title>

<style>

@page{
  size:A4;
  margin:0;
}

body{
  font-family:Arial, Helvetica, sans-serif;
  font-size:11px;
  background:#f2f2f2;
  margin:0;
}

#certificate{
  width:210mm;
  margin:auto;
  padding:5mm 20mm 20mm 20mm;
  box-sizing:border-box;
  background:#fff;
}

.cert-header{
  margin:-5mm -12mm 5mm -12mm;
}

.cert-header img{
  width:100%;
  display:block;
}

h3{
  text-align:center;
  margin:0 0 6px;
  font-size:26px;
}

h4{
  margin:10px 0 6px;
}

.subtitle{
  text-align:center;
  font-size:10px;
  margin-bottom:10px;
  line-height:1.4;
}

table{
  width:100%;
  border-collapse:collapse;
  margin-bottom:8px;
}

th,
td{
  border:1px solid #000;
  padding:4px;
  vertical-align:top;
  word-wrap:break-word;
}

table,
tr,
td,
th{
  page-break-inside:avoid;
}

input,
textarea,
select{
  width:100%;
  border:none;
  outline:none;
  background:transparent;
  font-family:inherit;
  font-size:11px;
  box-sizing:border-box;
}

textarea{
  resize:none;
}

/* =====================================
   DATE INPUT
   USES NATIVE HTML DATE ICON
===================================== */

input[type="date"]{
  width:100%;
  border:none;
  outline:none;
  background:transparent;
  font-family:inherit;
  font-size:11px;
  box-sizing:border-box;
}

/*
   When generating the PDF, remove the
   browser calendar icon but keep the date.
*/
<% if (isPdf) { %>

input[type="date"]{
  appearance:none !important;
  -webkit-appearance:none !important;
}

input[type="date"]::-webkit-calendar-picker-indicator{
  display:none !important;
  -webkit-appearance:none !important;
}

<% } %>


textarea{
  resize:none;
}

.image-box{
  width:100%;
  height:170px;
  border:1px solid #000;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

.image-box img{
  max-width:100%;
  max-height:100%;
  object-fit:contain;
}

.pdf-hide{
  display:<%= isPdf ? "none" : "block" %>;
}

.action-cell{
  width:45px;
  text-align:center;
}

.delete-btn{
  border:none;
  background:none;
  color:#c00;
  cursor:pointer;
  font-size:18px;
}

/* =====================================
   FLOATING DOWNLOAD BUTTON
===================================== */

.floating-toolbar{
    position:fixed;
    top:18px;
    right:24px;
    z-index:9999;
}

.toolbar-btn{

    min-width:52px;
    height:46px;

    padding:0 16px;

    border:none;
    border-radius:999px;

    background:#0f172a;
    color:#fff;

    font-family:Arial, Helvetica, sans-serif;
    font-size:13px;
    font-weight:600;

    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;

    cursor:pointer;

    box-shadow:
        0 5px 15px rgba(0,0,0,.18);

    transition:
        background .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
}

.toolbar-btn:hover{

    background:#1e293b;

    transform:translateY(-2px);

    box-shadow:
        0 8px 20px rgba(0,0,0,.23);
}

.toolbar-btn:active{
    transform:translateY(0);
}

.toolbar-btn:disabled{

    background:#334155 !important;

    cursor:not-allowed !important;

    opacity:.9 !important;

    transform:none !important;

    animation:downloadPulse 1.2s ease-in-out infinite;
}

@keyframes downloadPulse{

    0%{
        box-shadow:0 5px 15px rgba(0,0,0,.18);
    }

    50%{
        box-shadow:0 5px 24px rgba(15,23,42,.45);
    }

    100%{
        box-shadow:0 5px 15px rgba(0,0,0,.18);
    }

}

/* =====================================
   CERTIFICATE FOOTER
===================================== */

.certificate-footer {
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;                 /* space between left / center / right / QR */
  margin-top: 12px;
  padding: 0 4px;
  box-sizing: border-box;
  page-break-inside: avoid !important;
  break-inside: avoid !important;
}

/* =====================================
   LEFT — SIGNATURE
===================================== */

.footer-left {
  width: 24%;
  min-width: 0;
  flex: 0 1 24%;
  box-sizing: border-box;
  text-align: left;
  padding-right: 8px;
}

/* =====================================
   CENTER — STAMP
===================================== */

.footer-center {
  width: 32%;
  min-width: 0;
  flex: 0 1 32%;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  text-align: center;
  padding: 0 8px;
}

/* =====================================
   RIGHT — COMPANY LOGOS
===================================== */

.footer-right {
  width: 22%;
  min-width: 0;
  flex: 0 1 22%;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 6px;
  padding: 0 8px;
}

/* =====================================
   QR — OWN SPACE
===================================== */

.qr-verification {
  width: 16%;
  min-width: 0;
  flex: 0 0 16%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  margin: 0;
  padding: 0 4px;
  text-align: center;
  page-break-inside: avoid !important;
  break-inside: avoid !important;
}

/* =====================================
   SIGNATURE
===================================== */

.signature-img {
  width: 115px;
  max-height: 45px;

  object-fit: contain;
}


/* =====================================
   COMPANY LOGOS
===================================== */

.cert-logo {
  width: 45px;
  height: 30px;

  max-width: 45px;
  max-height: 30px;

  object-fit: contain;

  display: block;
}

/* =====================================
   STAMP — larger
===================================== */

.stamp-wrapper {
  position: relative;
  width: 240px !important;
  max-width: 100% !important;   /* stay inside center column */
  margin-left: 0;
  margin-right: 0;
  box-sizing: border-box;
}

.company-block {
  width: 100% !important;
  max-width: 240px !important;
  height: auto;
  max-height: 110px;
  object-fit: contain;
  display: block;
  margin: 0 auto;
}

/* =====================================
   STAMP DATE
===================================== */

.stamp-overlay {
  position: absolute;
  bottom: 10px;
  left: 18px;          /* nudge right a bit on the larger stamp */
  width: auto;
  text-align: left;
  pointer-events: none;
}

.stamp-date {
  font-size: 11px;
  font-weight: bold;
  color: skyblue;
  white-space: nowrap;
}

/* =====================================
   QR — OWN SPACE
===================================== */

.qr-verification {
  width: 18%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  margin: 0;
  padding: 0;
  text-align: center;
  page-break-inside: avoid !important;
  break-inside: avoid !important;
}

/* =====================================
   QR IMAGE
===================================== */

.qr-verification img {
  width: 75px !important;
  height: 75px !important;
  max-width: 75px !important;
  max-height: 75px !important;
  object-fit: contain;
  display: block;
}

/* =====================================
   QR TEXT
===================================== */

.qr-text {
  margin-top: 2px;
  width: 75px;
  font-size: 8px;
  line-height: 1.1;
  color: #333;
  text-align: center;
}

/* Hide calendar icon only when generating PDF */
<% if (isPdf) { %>
input[type="date"] {
  appearance: none !important;
  -webkit-appearance: none !important;
}

input[type="date"]::-webkit-calendar-picker-indicator,
input[type="date"]::-webkit-inner-spin-button,
input[type="date"]::-webkit-clear-button {
  display: none !important;
  -webkit-appearance: none !important;
  opacity: 0 !important;
  width: 0 !important;
  height: 0 !important;
  pointer-events: none !important;
}
<% } %>



/* =====================================
   PRINT
===================================== */

@media print {

  .pdf-hide {
    display: none !important;
  }

  .certificate-footer {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }

  /*
     Hide native browser calendar icon
     in printed/PDF version.
  */

  input[type="date"]::-webkit-calendar-picker-indicator {
    display:none !important;
    -webkit-appearance:none !important;
  }

  input[type="date"] {
    appearance:none !important;
    -webkit-appearance:none !important;
  }

}

</style>


</head>

<body
  data-cert-type="VISUAL-NDT"
  data-is-view="<%= viewMode ? 'true' : 'false' %>"
>

