<input
name="manufacturer"
value="<%= d.manufacturer || '' %>"
>
</td>

</tr>

<tr>

<td>
Production Cert. No:
<br>
<input
name="productionCertNo"
value="<%= d.productionCertNo || '' %>"
>
</td>

<td>
Production Date:
