<input
name="testProcedure"
value="<%= d.testProcedure || 'PD/030' %>"
>
</td>

</tr>

</table>

</td>

<td style="width:26%;">

<input
id="<%= imageField %>Input"
type="file"
accept="image/*"
data-field="<%= imageField %>"
onchange="previewImage(this,'<%= imageField %>')"
style="display:none;"
>

<div class="image-box">

<img
id="<%= imageField %>"
src="<%= d.images?.[imageField] || '' %>"
>

</div>

<button
type="button"
class="pdf-hide"
onclick="document.getElementById('<%= imageField %>Input').click()"
>
🖼 Select Image
</button>

</td>

</tr>

</table>

<h4>
EQUIPMENT DETAIL LIMITS
</h4>

<table>

<tr>

<td>
Radius / Angle of Test:
<br>
<input
name="radiusAngle"
value="<%= d.radiusAngle || '' %>"
>
</td>

<td>
Designed Tare Weight:
