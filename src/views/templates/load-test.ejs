<%
const d = data || {};

const imageField = "equipmentImg";

const rows =
  d.tables?.find(
    table => table.name === "load-test"
  )?.rows || [];

  const viewMode =
  typeof isView !== 'undefined' ? isView : false;

%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<title>
  Certificate Of Load Test
</title>

<style>

/* =====================================
   EASY RESIZE CONTROLS
   Change any value below to resize footer images
===================================== */

:root {
  /* Signature */
  --sig-width: 140px;
  --sig-max-height: 50px;

  /* Company Stamp */
  --stamp-width: 220px;
  --stamp-max-height: 80px;

  /* Certification logos (ASNT, LEEA, AWRF) */
  --logo-width: 52px;
  --logo-height: 36px;

  /* QR Code */
  --qr-size: 56px;
  --qr-text-size: 10px;
}

@page {
  size: A4;
  margin: 0;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 11px;
  background: #f2f2f2;
  margin: 0;
}

/* A4 */
#certificate {
  width: 210mm;
  margin: auto;
  padding: 5mm 20mm 20mm 20mm;
  box-sizing: border-box;
  background: #fff;
  overflow: hidden;
}

.cert-header {
  margin: -5mm -12mm 5mm -12mm;
}

.cert-header img {
  width: 100%;
  display: block;
}

table {
  width: 100%;
  border-collapse: collapse;
}

td,
th {
  border: 1px solid #000;
  padding: 2px 3px;
  vertical-align: middle;
  line-height: 1.1;
}

.no-border,
.no-border td,
.no-border tr {
  border: none !important;
}

.center {
  text-align: center;
}

.right {
  text-align: right;
}

.bold {
  font-weight: bold;
}

input,
textarea,
select {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  font-family: inherit;
  font-size: 10px;
  min-height: 18px;
  box-sizing: border-box;
}

textarea {
  resize: none;
}

.pdf-hide {
  display: <%= isPdf ? "none" : "block" %>;
}

.action-cell {
  width: 40px;
  text-align: center;
}

.delete-btn {
  border: none;
  background: none;
  color: #c00;
  font-size: 18px;
  cursor: pointer;
  font-weight: bold;
}

.delete-btn:hover {
  opacity: .85;
}

.add-btn {
  padding: 7px 12px;
  cursor: pointer;
}

/* ================================
   FLOATING DOWNLOAD BUTTON
================================ */

.floating-toolbar {
  position: fixed;
  top: 18px;
  right: 24px;
  z-index: 9999;
}

.toolbar-btn {
  background: #0f172a;
  color: #fff;
  border: none;
  border-radius: 999px;
  padding: 12px 18px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(0, 0, 0, .18);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition:
    background .2s ease,
    transform .2s ease,
    box-shadow .2s ease;
}

.toolbar-btn:hover {
  background: #1e293b;
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(0, 0, 0, .22);
}

.toolbar-btn:active {
  transform: translateY(0);
}

/* ================================
   HOURGLASS
================================ */

.toolbar-btn.generating {
  min-width: 150px;
  background: #334155;
}

.hourglass {
  display: inline-block;
  font-size: 17px;
  animation: hourglass-spin 1.2s ease-in-out infinite;
}

@keyframes hourglass-spin {
  0%   { transform: rotate(0deg); }
  40%  { transform: rotate(0deg); }
  50%  { transform: rotate(180deg); }
  90%  { transform: rotate(180deg); }
  100% { transform: rotate(360deg); }
}

/* ================================
   PDF GENERATING STATE
================================ */

body.pdf-generating .floating-toolbar {
  pointer-events: none;
}

h1 { margin: 0; }
h2 { margin: 2px 0; font-size: 15px; }
h3 { margin: 1px 0; font-size: 12px; }
p  { margin: 4px 0; }

br {
  display: block;
  margin: 2px 0;
}

/* ===================================== */
/* EQUIPMENT IMAGE */
/* ===================================== */

.equipment-image-section {
  margin: 15px auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  page-break-inside: avoid;
  break-inside: avoid;
}

.equipment-image-title {
  font-size: 16px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 8px;
}

.image-box {
  width: 150px;
  height: 150px;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  border: 1px solid #000;
}

.image-box img {
  max-width: 80%;
  max-height: 80%;
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
}

.image-upload-container {
  margin-top: 10px;
  text-align: center;
}

.image-upload-container button {
  padding: 6px 14px;
  cursor: pointer;
}

/* =====================================
   CERTIFICATE FOOTER
===================================== */

.certificate-footer {
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 6px;
  padding: 0;
  box-sizing: border-box;
  page-break-inside: avoid !important;
  break-inside: avoid !important;
}

/* =====================================
   LEFT — SIGNATURE
===================================== */

.footer-left {
  width: 27%;
  box-sizing: border-box;
  text-align: left;
  flex-shrink: 0;
}

.inspected-title {
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 3px;
}

.signature-img {
  width: var(--sig-width);
  max-height: var(--sig-max-height);
  object-fit: contain;
  margin: 3px 0;
  display: block;
}

.inspector-name {
  font-weight: 700;
  font-size: 12px;
}

.inspector-level {
  font-size: 10px;
}

/* =====================================
   CENTER — STAMP
===================================== */

.footer-center {
  width: 36%;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  text-align: center;
  flex-shrink: 0;
}

.stamp-wrapper {
  position: relative;
  display: block;
  width: var(--stamp-width);
  max-width: var(--stamp-width);
  box-sizing: border-box;
}

.company-block {
  width: var(--stamp-width) !important;
  max-width: var(--stamp-width) !important;
  height: auto !important;
  max-height: var(--stamp-max-height);
  object-fit: contain;
  display: block;
}

/* =====================================
   STAMP DATE
===================================== */

.stamp-overlay {
  position: absolute;
  bottom: 6px;
  left: 28px;
  width: 100%;
  text-align: left;
}

.stamp-date {
  font-size: 9px;
  font-weight: 600;
  color: skyblue;
  white-space: nowrap;
}

/* =====================================
   RIGHT — COMPANY LOGOS
===================================== */

.footer-right {
  width: 20%;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 4px;
  flex-shrink: 0;
}

.cert-logo {
  width: var(--logo-width) !important;
  height: var(--logo-height) !important;
  max-width: var(--logo-width) !important;
  max-height: var(--logo-height) !important;
  object-fit: contain;
  display: block;
}

/* =====================================
   QR / BARCODE
===================================== */

.qr-verification {
  width: 15% !important;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  margin: 0 !important;
  padding: 0 !important;
  text-align: center;
  flex-shrink: 0;
  page-break-inside: avoid !important;
  break-inside: avoid !important;
}

.qr-verification img {
  width: var(--qr-size) !important;
  height: var(--qr-size) !important;
  max-width: var(--qr-size) !important;
  max-height: var(--qr-size) !important;
  object-fit: contain;
  display: block;
}

.qr-text {
  margin-top: 1px !important;
  width: var(--qr-size) !important;
  font-size: var(--qr-text-size) !important;
  line-height: 1 !important;
  color: #333;
  text-align: center;
}

/* =====================================
   FOOTER SPACING
===================================== */

.footer-wrapper {
  width: 100%;
  margin-top: 5px;
  padding: 0;
  box-sizing: border-box;
}

<% if (isPdf) { %>
/* Hide date calendar icon in PDF only */
input[type="date"]::-webkit-calendar-picker-indicator,
input[type="date"]::-webkit-inner-spin-button,
input[type="date"]::-webkit-clear-button {
  display: none !important;
  -webkit-appearance: none;
  appearance: none;
  opacity: 0;
  width: 0;
  height: 0;
  pointer-events: none;
}

input[type="date"] {
  -webkit-appearance: none;
  appearance: none;
}
<% } %>

@media print {
  .pdf-hide {
    display: none !important;
  }

  .floating-toolbar {
    display: none !important;
  }
}

</style>

</head>

<body data-cert-type="LOAD-TEST" data-is-view="<%= viewMode ? 'true' : 'false' %>">

<div id="certificate">

<% if (!isPdf) { %>

<div class="floating-toolbar pdf-hide">

    <button
        type="button"
        class="toolbar-btn"
        onclick="downloadPDF(event)"
        title="Download PDF"
    >
        <span class="download-icon">⬇</span>
        <span class="download-text">Download PDF</span>
    </button>

</div>

<% } %>

<div class="cert-header">

<img
id="letterhead"
src="<%= branding?.letterhead || '' %>"
>


<!-- ============================= -->
<!-- TITLE -->
<!-- ============================= -->

<div class="center">

