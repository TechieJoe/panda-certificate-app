<!-- ===================================== -->
<!-- EQUIPMENT IMAGE -->
<!-- ===================================== -->

<div class="equipment-image-section">

    <div class="equipment-image-title">
        EQUIPMENT IMAGE
    </div>

    <input
        id="<%= imageField %>Input"
        type="file"
        accept="image/*"
        data-field="<%= imageField %>"
        onchange="previewImage(this,'<%= imageField %>')"
        style="display:none;"
    >

    <div class="image-box">

        <img
            id="<%= imageField %>"
            src="<%= d.images?.[imageField] || '' %>"
            alt="Equipment Image"
        >

    </div>

    <% if (!isPdf) { %>

    <div class="pdf-hide image-upload-container">

        <button
            type="button"
            onclick="document.getElementById('<%= imageField %>Input').click()"
        >
            🖼 Select Image
        </button>

    </div>

    <% } %>

</div>

<!-- ===================================== -->
<!-- FOOTER -->
<!-- ===================================== -->

<div>

<div class="footer-wrapper">
<div class="certificate-footer">

  <!-- LEFT -->

