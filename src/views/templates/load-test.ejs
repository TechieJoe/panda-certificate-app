    gap:8px;
  "
>

<span
  style="
    font-weight:bold;
    white-space:nowrap;
  "
>
CERT NO:
</span>

<input
  name="certificateNo"
  value="<%= d.certificateNo || '' %>"
  style="
    width:180px;
    border-bottom:1px solid #000;
    text-align:center;
  "
>

</div>

</td>
  </tr>

</table>

<table>

  <tr
    class="center"
    style="font-weight:bold;"
  >

    <td>
      CLIENT / OWNER
    </td>

    <td>
