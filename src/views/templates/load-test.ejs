      font-size:13px;
      line-height:1.35;
    "
  >
    <div>
      <strong>STATUTORY INSTRUMENTS 1998 NO: 2307</strong>
    </div>

    <div>
      The Lifting Operations and Lifting Equipment Regulations 1998
    </div>

    <div>
      <strong>STATUTORY INSTRUMENTS 1992 NO: 3073</strong>
    </div>

    <div>
      The Supply of Machinery (Safety) Regulations 1992
    </div>

    <div>
      <strong>STATUTORY INSTRUMENTS 1998 NO: 2306</strong>
    </div>

    <div>
      The Provision and Use of Work Regulations 1998
    </div>

  </div>

</div>

<br>

<table>

  <tr>

    <td
      colspan="3"
      style="
        border:none;
      "
    >
    </td>

<td
  style="
    border:none;
    width:280px;
  "
>

<div
  style="
    display:flex;
    justify-content:flex-end;
