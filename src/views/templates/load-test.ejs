    %>
  </span>
</div>

      </div>

    </div>

  </div>

  <!-- RIGHT -->

  <div class="footer-right">

    <img
      id="asnt"
      class="cert-logo"
      src="<%= branding?.asnt || '' %>"
    >

    <img
      id="leea"
      class="cert-logo"
      src="<%= branding?.leea || '' %>"
    >

    <img
      id="awrf"
      class="cert-logo"
      src="<%= branding?.awrf || '' %>"
    >

  </div>

  <%- include('../dashboard/partials/qr-code') %>

</div>
</div>
</div>

<!-- ===================================== -->
<!-- UNIVERSAL JS -->
<!-- ===================================== -->

<% if (!isPdf) { %>

<script src="/js/certificate.js"></script>

<% } %>

</body>

</html>