  <input
    name="ndtMethod"
    value="<%= d.ndtMethod || '' %>"
  >

  <br>

  <b>
    CONTACT MEDIA:
  </b>

  <input
    name="contactMedia2"
    value="<%= d.contactMedia2 || '' %>"
  >

  <br>

  <b>
