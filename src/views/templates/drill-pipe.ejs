<%
const d = data || {};

const drillRows =
    d.tables?.find(
        t => t.name === "drill-pipe-inspection"
    )?.rows || [];

const viewMode =
typeof isView !== 'undefined' ? isView : false;

%>


<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    background:#fff;

}


body{

    font-family:Arial,Helvetica,sans-serif;

    background:#ececec;

    padding:20px;

}

/* Scrollable area */

.report-wrapper{

    width:100%;

    overflow-x:auto;

    overflow-y:auto;

    border:1px solid #777;

    background:white;

    padding:15px;

}

/* Actual report */

.report{

    width:1850px;

    margin:auto;

    padding:0 8mm 8mm 8mm;
}

/* Tables */

table{

    width:100%;

    border-collapse:collapse;

}

th,
td{

    border:1px solid #000;

    text-align:center;

    vertical-align:middle;

    padding:2px;

    font-size:10px;

}

/* ===========================
   INSPECTION TABLE
=========================== */

.drill-table{
    width:100%;
    border-collapse:collapse;
    border:2px solid #000;
    table-layout:fixed;
}


.drill-table th,
.drill-table td{

    border:1px solid #000;

    text-align:center;

    vertical-align:middle;

    padding:2px;

    font-size:10px;

}

.drill-table th{

    font-weight:bold;

}

/* First Header Row */

.drill-table thead tr:first-child th{

    height:34px;

    font-size:11px;

    border-bottom:2px solid #000;

}

/* Second Header Row */

.drill-table thead tr:nth-child(2) th{

    height:28px;

}

/* Third Header Row */

.drill-table thead tr:nth-child(3) th{

    height:22px;

    font-size:9px;

}

/* Data Rows */

.drill-table tbody td{

    height:24px;

}

/* Inputs */

input{

    width:100%;

    border:none;

    outline:none;

    background:transparent;

    text-align:center;

    font-size:10px;

}

input:focus{

    background:#fff7c2;

}

.section-title{

    background:#fff;

    font-size:12px;

    letter-spacing:.5px;

    border-top:2px solid #000 !important;

    border-bottom:2px solid #000 !important;

}

.box-header{
    border-left:4px solid #000 !important;
}

.pin-header{
    border-left:4px solid #000 !important;
}

/* Header */

.cert-header{
    width:100%;
    margin-bottom:8px;
}

.cert-header img{
    display:block;
    width:100%;
    max-height:95px;
}

.title{

    text-align:center;

    font-size:22px;

    font-weight:bold;

    margin-bottom:12px;

}

.top-info{

    margin-bottom:15px;

}

.top-info td{

    text-align:left;

    padding:5px;

    height:32px;

}

.label{

    font-weight:bold;

}

.group{

    background:#f3f3f3;

    font-size:11px;

    font-weight:bold;

}

.subgroup{

    background:#fafafa;

    font-size:10px;

    font-weight:bold;

}

.bottom-section{

    display:flex;

    align-items:flex-start;

    justify-content:space-between;

    gap:18px;

    margin-top:15px;

}

.pipe-column{

    width:48%;

}

.box-column{

    width:20%;

}

.pin-column{

    width:32%;

}

.counter-header{

    font-size:9px;

}

.drill-table input{

    width:100%;

    height:100%;

    border:none;

    text-align:center;

    font-size:10px;

    padding:0;

    background:transparent;

}

/* ==========================
   SECTION SEPARATORS
========================== */

.pipe-divider{
    border-left:4px solid #000 !important;
}

.box-divider{
    border-left:4px solid #000 !important;
}

.pin-divider{
    border-left:4px solid #000 !important;
}

/*================================================*/

.bottom-section-table{

    width:100%;

    border-collapse:collapse;

    margin-top:5px;

}

.bottom-section-table>tbody>tr>td{

    border:1px solid #000;

    vertical-align:top;

    padding:4px;

}

.pipe-section{

    width:48%;

}

.box-section{

    width:18%;

}

.pin-section{

    width:34%;

}

/*================================================*/

.pipe-summary{

    width:100%;

    border-collapse:collapse;

}

.pipe-summary td{

    border:1px solid #000;

    height:24px;

}

.summary-label{

    width:120px;

    font-weight:bold;

    padding-left:8px;

}

.pipe-summary input{

    width:100%;

    height:100%;

    border:none;

    padding-left:8px;

}

/*================================================*/

.remark-table{

    width:100%;

    margin-top:6px;

    border-collapse:collapse;

}

.remark-table th{

    border:1px solid #000;

    height:24px;

}

.remark-table td{

    border:1px solid #000;

}

.remark-table textarea{

    width:100%;

    height:40px;

    border:none;

    resize:none;

    padding:5px;

    font-size:11px;

}

/*================================================*/

.repair-table{

    width:100%;

    margin-top:8px;

    border-collapse:collapse;

}

.repair-table td{

    border:1px solid #000;

    height:22px;

}

.repair-table th{

    height:24px;

    font-size:11px;

}

.repair-table td:first-child{

    width:85%;

    padding-left:8px;

    font-size:11px;

}

.repair-table td:last-child{

    width:15%;

}

.repair-table input{

    width:100%;

    height:100%;

    border:none;

    text-align:center;

}

/*================================================*/

.box-classification{

    width:100%;

    border-collapse:collapse;

}

.box-classification th,

.box-classification td{

    border:1px solid #000;

    height:28px;

}

.box-classification td:first-child{

    width:75%;

    padding-left:8px;

}

.box-classification td:last-child{

    width:25%;

}

.box-classification input{

    width:100%;

    height:100%;

    border:none;

    text-align:center;

}

/*================================================*/

.legend-table{
    width:100%;
    border-collapse:collapse;
}

.legend-table th{
    border:1px solid #000;
    padding:4px;
    font-size:11px;
}

.legend-table td{
    border:1px solid #000;
    vertical-align:top;
    width:50%;
    padding:4px 6px;
}

.legend-left{
    border-right:1px solid #000;
}

.legend-left div,
.legend-right div{
    margin-bottom:4px;
    font-size:10px;
    line-height:1.3;
}

/* Add Row */

#addRow{

    margin-top:12px;

    padding:8px 18px;

    cursor:pointer;

}

/* ================================
   DOWNLOAD PDF BUTTON
================================ */

.floating-toolbar{
    position:fixed;
    top:18px;
    left:18px;
    z-index:99999;
}

.toolbar-btn{
    display:flex !important;
    align-items:center;
    justify-content:center;
    gap:8px;

    min-width:150px;
    height:44px;

    padding:0 18px;

    border:none;
    border-radius:10px;

    background:#111827;
    color:#fff;

    font-family:Arial, Helvetica, sans-serif;
    font-size:13px;
    font-weight:700;

    cursor:pointer;

    box-shadow:0 4px 12px rgba(0,0,0,.20);

    transition:
        background .2s ease,
        transform .2s ease,
        box-shadow .2s ease,
        opacity .2s ease;
}

.toolbar-btn:hover{
    background:#1f2937;
    transform:translateY(-1px);
    box-shadow:0 6px 16px rgba(0,0,0,.25);
}

.toolbar-btn:active{
    transform:translateY(0);
}

.toolbar-btn:disabled{
    cursor:not-allowed;
    opacity:.65;
}

.download-icon{
    display:inline-flex !important;
    font-size:17px;
    line-height:1;
}

.download-text{
    display:inline-block !important;
    white-space:nowrap;
}


.table-actions{
    margin:15px 0;
}

.add-row-btn{
    padding:8px 18px;
    border:none;
    border-radius:4px;
    background:#28a745;
    color:#fff;
    font-size:14px;
    cursor:pointer;
}

.add-row-btn:hover{
    background:#218838;
}

.date-input{
    width:100%;
    border:none;
    background:transparent;
    font-size:10px;
}

.date-input::-webkit-calendar-picker-indicator{
    cursor:pointer;
    opacity:1;
}

/* =====================================
   EASY RESIZE CONTROLS
   Change any value below to resize footer images
===================================== */

:root {
  /* Company Stamp */
  --stamp-width: 300px;
  --stamp-max-height: 100px;

  /* Certification logos (ASNT, LEEA, AWRF) */
  --logo-width: 70px;
  --logo-height: 56px;

  /* QR Code */
  --qr-size: 70px;
  --qr-text-size: 5px;
}

/* ===========================
   CERTIFICATE FOOTER
=========================== */

.certificate-footer {
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 25px;
  gap: 12px;
  page-break-inside: avoid;
  break-inside: avoid;
}

.footer-left {
  width: 27%;
  flex-shrink: 0;
}

.footer-title {
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 5px;
}

.footer-name {
  font-weight: bold;
  font-size: 13px;
  margin-top: 4px;
}

.footer-qualification {
  font-size: 12px;
}

.footer-center {
  width: 36%;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  flex-shrink: 0;
}

.stamp-wrapper {
  position: relative;
  display: block;
  width: var(--stamp-width);
  max-width: var(--stamp-width);
  box-sizing: border-box;
}

.company-block {
  width: var(--stamp-width) !important;
  max-width: var(--stamp-width) !important;
  height: auto !important;
  max-height: var(--stamp-max-height);
  object-fit: contain;
  display: block;
}

.stamp-overlay {
  position: absolute;
  bottom: 6px;
  left: 12px;
  width: 100%;
  text-align: left;
}

.stamp-date {
  font-size: 9px;
  font-weight: 600;
  color: skyblue;
  white-space: nowrap;
}

.footer-right {
  width: 20%;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 4px;
  flex-shrink: 0;
}

.cert-logo {
  width: var(--logo-width) !important;
  height: var(--logo-height) !important;
  max-width: var(--logo-width) !important;
  max-height: var(--logo-height) !important;
  object-fit: contain;
  display: block;
}

/* QR */
.qr-verification {
  width: 15% !important;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  margin: 0 !important;
  padding: 0 !important;
  text-align: center;
  flex-shrink: 0;
  page-break-inside: avoid !important;
  break-inside: avoid !important;
}

.qr-verification img {
  width: var(--qr-size) !important;
  height: var(--qr-size) !important;
  max-width: var(--qr-size) !important;
  max-height: var(--qr-size) !important;
  object-fit: contain;
  display: block;
}

.qr-text {
  margin-top: 1px !important;
  width: var(--qr-size) !important;
  font-size: var(--qr-text-size) !important;
  line-height: 1 !important;
  color: #333;
  text-align: center;
}

/* Print */

@media print{

body{

background:white;

padding:0;

}

.report-wrapper{

border:none;

overflow:visible;

padding:0;

}

.report{

width:100%;

}

.drill-table tr{

    page-break-inside:avoid;

}
.no-print {
        display: none !important;
    }
    
}

.no-print {
    display: block;
}

</style>

    
<body data-cert-type="DRILL-PIPE" data-is-view="<%= viewMode ? 'true' : 'false' %>">

<div class="floating-toolbar pdf-hide">

    <button
        type="button"
        class="toolbar-btn no-print"
        onclick="downloadPDF(event)"
        title="Download PDF"
    >
        <span class="download-icon">⬇</span>
        <span class="download-text">Download PDF</span>
    </button>

</div>

<div id="certificate">

<div id="certificate">

<div class="report-wrapper">

<div class="report">

<div class="cert-header">
    <img
        id="letterhead"
        src="<%= branding?.letterhead || '' %>">
</div>

<div class="title">
    DRILL PIPE INSPECTION REPORT
</div>

<table class="top-info">

<tr>

<td style="width:25%;">

<span class="label">CUSTOMER :</span>

<input
name="customer"
value="<%= d.customer || '' %>">

</td>

<td style="width:20%;">

<span class="label">LOCATION :</span>

<input
name="location"
value="<%= d.location || '' %>">

</td>

<td style="width:15%;">

<span class="label">RIG :</span>

<input
name="rig"
value="<%= d.rig || '' %>">

</td>

<td style="width:20%;">

<span class="label">REPORT NO :</span>

<input
name="reportNo"
value="<%= d.reportNo || '' %>">

</td>

<td style="width:20%;">

<span class="label">DATE :</span>

<input
    type="date"
    name="date"
    data-stamp-date
    value="<%= d.date || '' %>"
>
</td>

</tr>

<tr>

<td>

<span class="label">SIZE :</span>

<input
name="size"
value="<%= d.size || '' %>">

</td>

<td>

<span class="label">GRADE :</span>

<input
name="grade"
value="<%= d.grade || '' %>">

</td>

<td>

<span class="label">WEIGHT :</span>

<input
name="weight"
value="<%= d.weight || '' %>">

</td>

<td>

<span class="label">NOM. WALL THICKNESS :</span>

<input
name="nominalWallThickness"
value="<%= d.nominalWallThickness || '' %>">

</td>

<td>

<span class="label">TOOL JOINT RANGE / COATED :</span>

<input
name="toolJointRangeCoated"
value="<%= d.toolJointRangeCoated || '' %>">

</td>

</tr>

</table>

<table id="inspectionTable">

<thead>

<!-- ===================== LEVEL 1 ===================== -->

<tr>

<th rowspan="3" style="width:40px;">S/N</th>

<th rowspan="3" style="width:70px;">ID NO</th>

<th colspan="6" class="section-title pipe-header">PIPE BODY</th>


<th colspan="10" class="section-title box-header">BOX TOOL JOINT</th>


<th colspan="10" class="section-title pin-header">PIN TOOL JOINT</th>


<th rowspan="3" class="pin-divider">FINAL<br>CLASS</th>

<th rowspan="3">TALLY<br>LENGTH</th>

<th rowspan="3">REMARK</th>

</tr>

<!-- ===================== LEVEL 2 ===================== -->

<tr>

<!-- PIPE BODY -->

<th colspan="2">CORROSION</th>

<th rowspan="2">INT/COAT</th>

<th rowspan="2">MIN WALL<br>THICK<br>(INCHES)</th>

<th rowspan="2">BENT</th>

<th rowspan="2">EMI/UT</th>

<!-- BOX TOOL JOINT -->

<th rowspan="2" class="pipe-divider">OD</th>

<th rowspan="2">HB OD<br>COND</th>

<th rowspan="2">BEVEL<br>DIA</th>

<th colspan="2">COUNTERBORE</th>

<th rowspan="2">BOX/L</th>

<th rowspan="2">LEAD<br>GAUGE</th>

<th rowspan="2">TONG<br>SPACE</th>

<th rowspan="2">CONDT</th>

<th rowspan="2">MPI/UT</th>

<!-- PIN TOOL JOINT -->

<th rowspan="2" class="box-divider">ID</th>

<th rowspan="2">OD</th>

<th rowspan="2">BEVEL<br>DIA</th>

<th rowspan="2">CY/DIA</th>

<th rowspan="2">PIN<br>NOSE</th>

<th rowspan="2">LEAD<br>GAUGE</th>

<th rowspan="2">PIN<br>LENGTH</th>

<th rowspan="2">TONG<br>SPACE</th>

<th rowspan="2">CONDT</th>

<th rowspan="2">MPI/UT</th>


</tr>

<!-- ===================== LEVEL 3 ===================== -->

<tr>

<!-- PIPE BODY -->

<th>INT</th>

<th>EXT</th>

<!-- BOX -->

<th>WALL<br>THICK</th>

<th>DIA</th>

</tr>

</thead>

<tbody
    data-table-name="drill-pipe-inspection"
    data-add-row="drill-pipe-inspection"
>

<%
const fields = [
    "idNo",

    "corrosionInt",
    "corrosionExt",
    "intCoat",
    "minWallThickness",
    "bent",
    "emiUt",

    "boxOd",
    "hbOdCond",
    "boxBevelDia",
    "counterboreWallThickness",
    "counterboreDia",
    "boxLength",
    "boxLeadGauge",
    "boxTongSpace",
    "boxCondition",
    "boxMpiUt",

    "pinId",
    "pinOd",
    "pinBevelDia",
    "pinCyDia",
    "pinNose",
    "pinLeadGauge",
    "pinLength",
    "pinTongSpace",
    "pinCondition",
    "pinMpiUt",

    "finalClass",
    "tallyLength",
    "remark"
];
%>

<% if (drillRows.length) { %>

    <% drillRows.forEach((row,index)=> { %>

    <tr class="inspection-row">

        <td class="sn"><%= index + 1 %></td>

      <% fields.forEach(function(field, index){ %>

    <td class="
        <%= index === 6 ? 'pipe-divider' : '' %>
        <%= index === 16 ? 'box-divider' : '' %>
        <%= index === 26 ? 'pin-divider' : '' %>
    ">
        <input
            type="text"
            name="<%= field %>"
            value="<%= row?.[field] || '' %>">
    </td>

<% }) %>

        <% if(!isPdf){ %>
        <td class="pdf-hide">
            <button
                type="button"
                class="delete-btn"
                onclick="deleteRow(this)">
                ×
            </button>
        </td>
        <% } %>

    </tr>

    <% }) %>

<% } else { %>

<tr class="inspection-row">

    <td class="sn">1</td>

   <% fields.forEach(function(field, index){ %>

    <td class="
        <%= index === 7 ? 'pipe-divider' : '' %>
        <%= index === 17 ? 'box-divider' : '' %>
        <%= index === 27 ? 'pin-divider' : '' %>
    ">
        <input
            type="text"
            name="<%= field %>">
    </td>

<% }) %>

    <% if(!isPdf){ %>
    <td class="pdf-hide">
        <button
            type="button"
            class="delete-btn"
            onclick="deleteRow(this)">
            ×
        </button>
    </td>
    <% } %>

</tr>

<% } %>

</tbody>

<% if(!isPdf){ %>

<div class="table-actions pdf-hide">

    <button
        type="button"
        class="add-row-btn"
        onclick="addRow('drill-pipe-inspection')">

        + Add Row

    </button>

</div>

<% } %>

</table>
<!-- ====================== BOTTOM SECTION ====================== -->

<table class="bottom-section-table">

<tr>

    <!-- ===================================================== -->
    <!-- PIPE BODY -->
    <!-- ===================================================== -->

    <td class="pipe-section">

