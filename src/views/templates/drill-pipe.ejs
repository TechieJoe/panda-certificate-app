                </td>

            </tr>

        </table>

    </td>

    <!-- ===================================================== -->
    <!-- BOX TOOL JOINT -->
    <!-- ===================================================== -->

    <td class="box-section">

        <table class="box-classification">

            <tr>

                <th colspan="2">

                    CLASSIFICATION

                </th>

            </tr>

            <tr>

                <td>PREMIUM</td>

                <td>

                    <input
                        name="boxClassification.premium"
                        value="<%= d.boxClassification?.premium || '' %>">

                </td>

            </tr>

            <tr>

                <td>CLASS 2</td>

                <td>

                    <input
                        name="boxClassification.class2"
                        value="<%= d.boxClassification?.class2 || '' %>">

                </td>

            </tr>

            <tr>

                <td>SCRAP</td>

                <td>

                    <input
                        name="boxClassification.scrap"
                        value="<%= d.boxClassification?.scrap || '' %>">

                </td>

            </tr>

            <tr>

                <td>TOTAL</td>

                <td>

                    <input
                        name="boxClassification.total"
                        value="<%= d.boxClassification?.total || '' %>">

                </td>

            </tr>

        </table>

    </td>

    <!-- ===================================================== -->
    <!-- PIN TOOL JOINT -->
    <!-- ===================================================== -->

    <td class="pin-section">

      <table class="legend-table">
    <tr>
        <th colspan="2">ABBREVIATIONS</th>
    </tr>

    <tr>
        <td class="legend-left">

            <div>SD - SHOULDER DAMAGE</div>
            <div>TD - THREAD DAMAGE</div>
            <div>OT - OVAL THREAD</div>
            <div>PS - PRESSURE SEAL</div>
            <div>GT - GOUGE</div>
            <div>WO - WASH OUT</div>
            <div>CRK - CRACK</div>
            <div>STJ - SHORT TOOL JOINT</div>
            <div>HBD - HARD BAND DAMAGE</div>

        </td>

        <td class="legend-right">

            <div>RF - REFACED</div>
            <div>ACC - ACCEPT</div>
            <div>NA - NOT APPLICABLE</div>
            <div>W - WORN</div>

        </td>
    </tr>
</table>
    </td>

</tr>

</table>


</div>

