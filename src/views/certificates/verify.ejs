<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Certificate Verification
    </title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #0f172a;
        }

        .verification-header {
            background: #0f172a;
            color: white;
            padding: 20px;
            text-align: center;
        }

        .verification-header h1 {
            margin: 0;
            font-size: 22px;
        }

        .verification-header p {
            margin: 8px 0 0;
            color: #cbd5e1;
            font-size: 14px;
        }

        .verification-container {
            max-width: 1200px;
            margin: 25px auto;
            padding: 0 15px;
        }

        .verification-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow:
                0 4px 20px rgba(0,0,0,.08);
        }

        .verified {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #15803d;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .pdf-container {
            width: 100%;
            height: 80vh;
            min-height: 600px;
        }

        .pdf-container iframe {
            width: 100%;
            height: 100%;
            border: none;
            border-radius: 8px;
        }

        .download-btn {
            display: inline-block;
            margin-top: 15px;
            padding: 12px 18px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
        }

        @media (max-width: 768px) {

            .verification-container {
                margin: 15px auto;
            }

            .verification-card {
                padding: 12px;
            }

            .pdf-container {
                height: 75vh;
                min-height: 500px;
            }

        }

    </style>

</head>

<body>

    <header class="verification-header">

        <h1>
            PANDA INTEGRATED SERVICES LTD
        </h1>

        <p>
            Certificate Verification
        </p>

    </header>


    <main class="verification-container">

        <div class="verification-card">

            <div class="verified">
                🟢 Certificate Verified
            </div>


            <div class="pdf-container">

                <iframe
                    src="<%= pdfUrl %>"
                    title="Verified Certificate"
                ></iframe>

            </div>


            <a
                href="<%= pdfUrl %>"
                target="_blank"
                class="download-btn"
            >
                Open / Download PDF
            </a>

        </div>

    </main>

</body>

</html>