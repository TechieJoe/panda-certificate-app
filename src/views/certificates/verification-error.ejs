<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    Certificate Not Found
  </title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
    }

    .error {
      max-width: 500px;
      margin: 100px auto;
      padding: 30px;
      background: white;
      border-radius: 12px;
      text-align: center;
      box-shadow: 0 5px 20px rgba(0,0,0,.08);
    }

    h1 {
      color: #dc2626;
    }

    p {
      color: #64748b;
    }

    .brand {
      margin-top: 20px;
      font-size: 13px;
      color: #94a3b8;
    }
  </style>
</head>

<body>

  <div class="error">
    <h1>
      ❌ Certificate Not Found
    </h1>

    <p>
      This certificate could not be verified.
    </p>

    <div class="brand">
      PANDA INTEGRATED ENERGY SERVICES
    </div>
  </div>

</body>
</html>