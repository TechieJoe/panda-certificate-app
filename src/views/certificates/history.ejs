<h1 class="page-title">
    Certificate History
</h1>


<!-- SEARCH BAR -->
<div class="top-bar">

    <form
        action="/certificates/history"
        method="GET"
        class="search-container"
    >

        <span class="search-icon">🔍</span>

        <input
            id="searchInput"
            type="text"
            name="search"
            autocomplete="on"
            value="<%= search || '' %>"
            placeholder="Client, Equipment, Serial No..."
        >

        <button
            class="search-btn"
            type="submit"
        >
            Search
        </button>

        <div id="searchSuggestions"></div>

    </form>

</div>

<p class="history-count">
    Showing
    <strong><%= certificates.length %></strong>
    certificate(s)
</p>

<table class="history-table">

    <thead>

        <tr>

            <th>Client</th>

            <th>Template</th>

            <th>Certificate No.</th>

            <th>Status</th>

            <th>Date</th>

            <th>Actions</th>

        </tr>

    </thead>

    <tbody>

        <% if(certificates.length === 0){ %>

            <tr>

                <td colspan="6" class="empty">

                    No certificates found.

                </td>

            </tr>

        <% } %>

        <% certificates.forEach(cert=>{ %>

            <tr>

                <td>

                    <%= cert.data?.client ||
                        cert.data?.equipmentOwner ||
                        '-' %>

                </td>

                <td>

                    <%= cert.template %>

                </td>

                <td>

                    <%= cert.data?.certificateNo || '-' %>

                </td>

                <td>

                    <% if(cert.status === 'edited'){ %>

                        🟡 Edited

                    <% } else { %>

                        🟢 New

                    <% } %>

                </td>

                <td>

                    <%= new Date(cert.createdAt).toLocaleDateString() %>

                </td>

                <td class="actions">

                    <a href="/certificates/<%= cert._id %>/view">
                        👁
                    </a>

                    <a href="/certificates/<%= cert._id %>/edit">
                        ✏
                    </a>

                    <form
                        action="/certificates/<%= cert._id %>/delete"
                        method="POST"
                        style="display:inline"
                    >

                        <button
                            onclick="return confirm('Delete this certificate?')"
                        >
                            🗑
                        </button>

                    </form>

                </td>

            </tr>

        <% }) %>

    </tbody>

</table>

<div class="pagination">

    <% if(currentPage > 1){ %>

        <a
            href="?page=<%= currentPage-1 %>&search=<%= search %>&template=<%= template %>&status=<%= status %>&from=<%= from %>&to=<%= to %>"
        >
            ← Previous
        </a>

    <% } %>

    <span>

        Page <%= currentPage %> of <%= totalPages %>

    </span>

    <% if(currentPage < totalPages){ %>

        <a
            href="?page=<%= currentPage+1 %>&search=<%= search %>&template=<%= template %>&status=<%= status %>&from=<%= from %>&to=<%= to %>"
        >
            Next →
        </a>

    <% } %>

</div>